# Copy to .env and fill in. Never commit your real .env (it is gitignored).

# --- Required (Telegram bot) ---------------------------------------------
# Bot token from @BotFather. bot.py fails to start without it.
TELEGRAM_BOT_TOKEN=

# --- Optional ------------------------------------------------------------
# Anthropic API key. If empty/unset, the code falls back to a local Ollama model.
ANTHROPIC_API_KEY=

# Your numeric Telegram user ID. Only this user may talk to the bot.
# If empty: discovery mode — anyone can write to the bot and every incoming
# user_id is logged. Read your ID from the log, put it here, restart the bot.
TELEGRAM_ALLOWED_USER_ID=

# Local Ollama fallback (used when ANTHROPIC_API_KEY is not set).
# Values below are the code defaults. Do not leave these as empty lines —
# an empty value overrides the default.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Knowledge vault -----------------------------------------------------
# Absolute path to your private knowledge vault (wiki/, raw/, index.md, log.md).
# Unset = the bundled fictional demo vault in sample_vault/.
# Keep this commented out unless you set a real path: an empty
# "KOS_VAULT_ROOT=" line would be loaded as an empty string.
# KOS_VAULT_ROOT=/path/to/your/knowledge-vault
